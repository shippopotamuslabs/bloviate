# Copy to keystore.properties in the repo root (gitignored) and fill in secrets.
# Used by app/build.gradle.kts for signed release APK builds.
#
#   cp keystore.properties.example keystore.properties
#
# Paths are relative to the repo root.

storeFile=.keystore/bloviate_keystore.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
keyPassword=REPLACE_WITH_KEY_PASSWORD
