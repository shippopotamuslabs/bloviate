    <string name="mic_status_missing">Microphone permission: not granted</string>
    <string name="mic_request">Grant microphone permission</string>
    <string name="mic_hint">Dictation needs the microphone. Grant it here; the bubble service then runs with the microphone foreground-service type and recording becomes available once the model has downloaded (watch logcat tags “ModelStore”, “TranscriptionEngine”, “RecordingSession”).</string>
