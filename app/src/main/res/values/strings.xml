    <string name="bubble_service_running">Bubble service: running</string>
    <string name="bubble_service_stopped">Bubble service: stopped</string>
    <string name="bubble_start">Start bubble</string>
    <string name="bubble_stop">Stop bubble</string>
    <string name="bubble_hint">Start the bubble, then tap a text field in any app — the bubble appears only over editable fields, never on password fields. Drag it to move it (the spot is remembered), or drag it to the bottom edge to dismiss it for that field.</string>
