<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Resident presence (ENC-129): the boot receiver restarts the bubble service after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The one network use in the app: downloading the on-device model file. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Battery exemption (ENC-139, ENC-143): the system honors
         ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS only when the app holds
         this permission; without the declaration the one-tap dialog is
         refused on dispatch. Normal install-time permission, no runtime
         prompt. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".BloviateApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bloviate">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Bloviate"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.FieldWatcherService"
            android:exported="true"
            android:label="@string/field_watcher_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Foreground types (ENC-60, ENC-129): every start begins as
          specialUse — the only type legal in every start context — and
          promotes to microphone once the start's origin is known eligible
          and RECORD_AUDIO is granted (Android 14+ refuses a microphone-typed
          FGS without the grant, and Android 15 refuses one from a boot
          receiver entirely). The subtype property below is required
          because specialUse remains a declared type.
        -->
        <service
            android:name=".service.BubbleOverlayService"
            android:exported="false"
            android:foregroundServiceType="microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows a user-enabled floating dictation bubble over editable text fields in other apps" />
        </service>

        <!--
          Boot start (ENC-129) and update re-arm (BLO-189): BOOT_COMPLETED
          and MY_PACKAGE_REPLACED are protected broadcasts — only the
          system can send them — so the exported receiver cannot be
          triggered by other apps. The receiver itself gates on the
          resident-presence record before starting the bubble service.
          MY_PACKAGE_REPLACED is not delivered while the app is
          force-stopped, so a stopped app stays stopped until the user
          opens it again.
        -->
        <receiver
            android:name=".service.BubbleAutoStartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
